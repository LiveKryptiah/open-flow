{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/auth", "destination": "/login.html" },
    { "source": "/portal", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/api/(.*)", "destination": "/api/index.py?route=$1" }
  ]
}
